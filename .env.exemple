# ============================================================
# BOT CHIP — ARQUIVO DE CONFIGURAÇÃO
# Copie este arquivo para .env e preencha os valores
# NUNCA compartilhe seu .env com ninguém
# ============================================================


# ============================================================
# DEV
# ============================================================

TOKEN="" # IMPORTANTE: Token do bot — nunca deixe vazar. Gere em discord.com/developers
SERVIDOR= # ID do servidor principal onde o bot vai operar
SERVIDOR_DOS_DEVS= # ID do servidor dos devs (pode ser o mesmo que SERVIDOR)
CARGO_DOS_DEVS= # ID do cargo de devs — quem tiver esse cargo no servidor de devs tem permissões elevadas sobre o bot (c+backup, c+git, etc)


# ============================================================
# CANAIS
# ID dos canais de texto usados pelo bot
# Aceita múltiplos IDs separados por vírgula em CANAL_COMANDOS
# ============================================================

CODIGO_ANTECIPADO= # Canal onde membros antecipados enviam o código da sala (6 letras) — bot valida, apaga e reencaminha
CODIGO_PUBLICO= # Canal público onde o código é publicado 30s depois do antecipado
CODIGO_LEMBRETE= # Canal onde o bot envia o lembrete de código para o chat da live
CHANNEL_LOG_ID= # Canal de log legado (pode ser o mesmo que LOGS_CODIGOS)
CANAL_BANCO= # Canal onde o UnbelievaBoat anuncia compras de VIP — bot lê e ativa automaticamente
CANAL_COMANDOS= # Canal(is) onde os comandos do bot podem ser usados — aceita múltiplos: ID1, ID2, ID3
CANAL_ANUNCIO_LIVES= # Canal onde o bot anuncia lives programadas e lives ao vivo
CANAL_ANUNCIO_VIDEOS= # Canal onde o bot anuncia vídeos novos e Shorts


# ============================================================
# YOUTUBE
# Necessário para monitorar lives, vídeos, Shorts e chat da live
# Crie uma chave em console.cloud.google.com → YouTube Data API v3
# OAuth2 necessário para monitorar e interagir com o chat da live
# ============================================================

GMAIL_CBOT= # Gmail usado na conta do YouTube do bot (ex: cbotrpyt51@gmail.com)
YOUTUBE_API_KEY= # Chave da API do YouTube Data v3 (console.cloud.google.com)
YOUTUBE_CANAL_ID= # ID do canal do YouTube — encontre em youtube.com/channel/ID ou no código fonte da página
# https://www.youtube.com/channel/
CLIENT_SECRET_YT= # Caminho para o arquivo client_secret.json do OAuth2 (ex: /caminho/para/client_secret.json)


# ============================================================
# CALLS
# ID dos canais de voz usados pelo painel
# ============================================================

Call_Live= # Canal de voz da live — bot gerencia entrada, fala, mute e kick
Call_Reconectar= # Canal de voz auxiliar usado para forçar reconexão dos membros


# ============================================================
# WEBHOOKS
# URLs completas — NUNCA deixe vazar, tratar como senhas
# Quem tiver a URL pode enviar mensagens no canal como se fosse o bot
# ============================================================

CODIGO_SALAS_ANTECIPADO= # Webhook do canal antecipado (usado apenas para apagar mensagens antigas do timer)


# ============================================================
# CARGOS
# ID dos cargos principais do servidor
# ============================================================

Administrador= # Cargo base de hierarquia — acima dele = imune à moderação automática
Vip= # Cargo dado automaticamente ao ativar VIP
Amigos= # Cargo dado manualmente ou via painel para membros próximos
MEMBRO_YT= # Cargo dado automaticamente a membros do canal YouTube (sincronizado via chat da live)
MODERADOR_YT= # Cargo dado automaticamente a moderadores do canal YouTube (sincronizado via chat da live)


# ============================================================
# PINGS
# ID dos cargos que recebem ping em cada tipo de anúncio
# O bot menciona o cargo no formato <@&ID> automaticamente
# ============================================================

PING_LEMBRETE= # Cargo pingado no lembrete de código durante a live
PING_LIVE_PROGRAMADA= # Cargo pingado quando uma live é agendada no YouTube
PING_LIVE_AO_VIVO= # Cargo pingado quando uma live começa ao vivo (e quando encerra)
PING_VIDEO_NOVO= # Cargo pingado quando um vídeo novo é publicado
PING_SHORTS_NOVO= # Cargo pingado quando um Short novo é publicado


# ============================================================
# PESSOAS
# ID de usuários específicos usados internamente pelo bot
# ============================================================

BOT_BANCO_ID= # ID do bot UnbelievaBoat — usado para filtrar mensagens no canal de banco
DONO_BOT= # ID do dono do bot — permissões máximas
CHIP= # ID do usuário Chip — tratamento especial em algumas funcionalidades


# ============================================================
# MEMÓRIA
# Caminhos absolutos para os arquivos .json de persistência
# Certifique-se que a pasta existe e o bot tem permissão de escrita
# ============================================================

ARQUIVO_VIPS=/.../.json # Armazena VIPs ativos, tempo restante e histórico
ARQUIVO_AMIGOS=/.../.json # Armazena quem tem o cargo de Amigo
ARQUIVO_TIMERS=/.../.json # Armazena timers de código em andamento (persistem entre restarts)
ARQUIVO_WARNS=/.../.json # Armazena todos os warns (ativos, expirados e removidos)
ARQUIVO_AV_BANCO=/.../.json # Armazena ID da última mensagem do banco processada (evita duplicar VIP após restart)
ARQUIVO_MODERACAO=/.../.json # Histórico de avisos de moderação por usuário (janela de 1h30 para virar warn)
ARQUIVO_YOUTUBE=/.../.json # Armazena último vídeo/short/live anunciado (evita anúncio duplicado)


# ============================================================
# PASTAS
# Caminhos absolutos para as pastas principais do bot
# ============================================================

PASTA_BACKUP= # Pasta onde os backups são salvos — contém cópias do .env e todos os arquivos. Proteja com cuidado
PASTA_MEMORIAS= # Pasta onde ficam todos os .json de memória do bot
PASTA_SRC= # Pasta raiz do código-fonte do bot (onde fica bot.py, .env, Modulos/)


# ============================================================
# LOGS
# ID dos canais de texto onde o bot envia logs automáticos
# Cada categoria tem seu próprio canal para facilitar a leitura
# ============================================================

LOGS_GERAIS= # Bot online/offline, erros gerais, Git e backup automático
LOGS_CODIGOS= # Todos os eventos de código: enviado, publicado, expirado, lembrete
LOGS_PAINEL= # Ações feitas pelo painel: quem abriu, qual seção acessou
LOGS_JOIN= # Canal público de boas-vindas e saídas (mensagem com ping e avatar do membro)
LOGS_WARNS= # Warns aplicados, removidos e expirados
LOGS_VIP= # VIP adicionado, removido, expirado automaticamente e ativado pelo banco
LOGS_AMIGOS= # Cargo de Amigo adicionado ou removido (qualquer origem)
LOGS_PUNICOES= # Warns, timeouts, kicks e bans — tanto pelo bot quanto feitos manualmente por admins
LOGS_MODERACAO= # Flood detectado, links bloqueados, divulgação, comandos em local errado
LOGS_MEMBROS= # Entrada e saída, contas novas, cargos adicionados/removidos, apelido alterado
LOGS_MENSAGENS= # Mensagens apagadas (com conteúdo quando possível) e editadas (antes e depois)
LOGS_CALLS= # Entrada, saída, movimentação, expulsão, mute e surdo por admin
LOGS_SERVIDOR= # Alterações no servidor: nome, foto, verificação, notificações, AFK
LOGS_CANAIS= # Canais criados, deletados, renomeados e permissões alteradas
LOGS_CARGOS= # Cargos criados, deletados, renomeados e permissões alteradas
