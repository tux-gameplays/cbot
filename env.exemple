# ============================================================
# BOT CHIP — ARQUIVO DE CONFIGURAÇÃO
# Copie este arquivo para .env e preencha os valores
# NUNCA compartilhe seu .env com ninguém
#
# Regras do arquivo:
# - Comentário vai sempre em linha própria. Comentário na mesma linha de uma
#   variável em branco vira o valor dela.
# - Variável de ID em branco quebra o bot: preencha ou apague a linha.
# - Listas aceitam vários IDs, um por linha, entre { }.
#   Dentro do bloco dá pra comentar com # depois do ID. Exemplo:
#       CANAL_COMANDOS={
#       111111111111111111 # Canal de comandos
#       222222222222222222 # Staff CMD
#       }
#   Também vale em uma linha só: CANAL_COMANDOS=111111111111111111, 222222222222222222
# ============================================================


# ============================================================
# DEV
# ============================================================

# Token do bot — nunca deixe vazar. Gere em discord.com/developers
TOKEN=""
# ID do servidor principal onde o bot vai operar
SERVIDOR=
# ID do servidor dos devs (pode ser o mesmo que SERVIDOR)
SERVIDOR_DOS_DEVS=
# ID do cargo de devs — quem tiver esse cargo no servidor de devs tem permissões elevadas sobre o bot (c+backup, c+git, etc)
CARGO_DOS_DEVS=
# Link de convite do servidor — enviado na DM de aviso do softban do honeypot
CONVITE=


# ============================================================
# CANAIS
# ID dos canais de texto usados pelo bot
# ============================================================

# Canal onde membros antecipados enviam o código da sala (6 letras) — bot valida, apaga e reencaminha
CODIGO_ANTECIPADO=
# Canal público onde o código é publicado 30s depois do antecipado
CODIGO_PUBLICO=
# Canal onde o bot envia o lembrete de código para o chat da live
CODIGO_LEMBRETE=
# Canal de log legado (pode ser o mesmo que LOGS_CODIGOS)
CHANNEL_LOG_ID=
# Canal onde o UnbelievaBoat anuncia compras de VIP — bot lê e ativa automaticamente
CANAL_BANCO=
# LISTA — canais onde os comandos c+ podem ser usados. Vazio = sem restrição
CANAL_COMANDOS={
}
# LISTA — canais onde qualquer link é permitido (convite de outros servidores continua bloqueado)
CANAL_LINKS_WHITELIST={
}
# Canal armadilha: quem estiver abaixo de GERENTE e mandar mensagem aqui leva softban
CANAL_HONEYPOT=
# Canal onde o bot anuncia lives programadas e lives ao vivo
CANAL_ANUNCIO_LIVES=
# Canal onde o bot anuncia vídeos novos e Shorts
CANAL_ANUNCIO_VIDEOS=
# Canal ponte das salas públicas (webhook externo posta aqui e o bot cria o embed)
SALAS_PONTE=
# Canal ponte das salas antecipadas
ANTECIPADO_PONTE=


# ============================================================
# YOUTUBE
# Necessário para monitorar lives, vídeos, Shorts e chat da live
# Crie uma chave em console.cloud.google.com → YouTube Data API v3
# OAuth2 necessário para monitorar e interagir com o chat da live
# ============================================================

# Gmail usado na conta do YouTube do bot (ex: seubot@gmail.com). Use senha própria, nunca o token do bot
GMAIL_CBOT=
# Chave da API do YouTube Data v3 (console.cloud.google.com)
YOUTUBE_API_KEY=
# ID do canal do YouTube — encontre em youtube.com/channel/ID ou no código fonte da página
YOUTUBE_CANAL_ID=
# Caminho para o arquivo client_secret.json do OAuth2 (ex: /caminho/para/client_secret.json)
CLIENT_SECRET_YT=


# ============================================================
# CALLS
# ID dos canais de voz usados pelo painel
# ============================================================

# Canal de voz da live — bot gerencia entrada, fala, mute e kick
Call_Live=
# Canal de voz auxiliar usado para forçar reconexão dos membros
Call_Reconectar=


# ============================================================
# WEBHOOKS
# URLs completas — NUNCA deixe vazar, tratar como senhas
# Quem tiver a URL pode enviar mensagens no canal como se fosse o bot
# ============================================================

# Webhook do canal antecipado (usado apenas para apagar mensagens antigas do timer)
CODIGO_SALAS_ANTECIPADO=


# ============================================================
# CARGOS
# ID dos cargos principais do servidor
# ============================================================

# Cargo mais alto além dos donos — quem tem esse cargo ou acima é isento do honeypot
GERENTE=
# Cargo base de hierarquia — acima dele = imune à moderação automática e quem usa o painel e os comandos de gerência
Administrador=
# Cargo dado automaticamente ao ativar VIP
Vip=
# Cargo dado manualmente ou via painel para membros próximos
Amigos=
# Cargo dado automaticamente a membros do canal YouTube (sincronizado via chat da live)
MEMBRO_YT=
# Cargo dado automaticamente a moderadores do canal YouTube (sincronizado via chat da live)
MODERADOR_YT=


# ============================================================
# PINGS
# ID dos cargos que recebem ping em cada tipo de anúncio
# O bot menciona o cargo no formato <@&ID> automaticamente
# ============================================================

# Cargo pingado no lembrete de código durante a live
PING_LEMBRETE=
# Cargo pingado quando uma live é agendada no YouTube
PING_LIVE_PROGRAMADA=
# Cargo pingado quando uma live começa ao vivo (e quando encerra)
PING_LIVE_AO_VIVO=
# Cargo pingado quando um vídeo novo é publicado
PING_VIDEO_NOVO=
# Cargo pingado quando um Short novo é publicado
PING_SHORTS_NOVO=


# ============================================================
# PESSOAS
# ID de usuários específicos usados internamente pelo bot
# ============================================================

# ID do bot UnbelievaBoat — usado para filtrar mensagens no canal de banco
BOT_BANCO_ID=
# ID do dono do bot — permissões máximas
DONO_BOT=
# ID do usuário Chip — tratamento especial em algumas funcionalidades
CHIP=


# ============================================================
# MEMÓRIA
# Caminhos absolutos para os arquivos .json de persistência
# Certifique-se que a pasta existe e o bot tem permissão de escrita
# ============================================================

# Armazena VIPs ativos, tempo restante e histórico
ARQUIVO_VIPS=/.../Vips.json
# Armazena quem tem o cargo de Amigo
ARQUIVO_AMIGOS=/.../Amigos.json
# Armazena timers de código em andamento (persistem entre restarts)
ARQUIVO_TIMERS=/.../Timers.json
# Armazena todos os warns (ativos, expirados e removidos)
ARQUIVO_WARNS=/.../Warns.json
# Armazena ID da última mensagem do banco processada (evita duplicar VIP após restart)
ARQUIVO_AV_BANCO=/.../Banco Vip Auto.json
# Histórico de avisos de moderação por usuário (janela de 1h30 para virar warn)
ARQUIVO_MODERACAO=/.../Moderacao.json
# Armazena último vídeo/short/live anunciado (evita anúncio duplicado)
ARQUIVO_YOUTUBE=/.../Youtube.json
# Opcional — salas ativas das pontes. Vazio = Salas.json na mesma pasta de ARQUIVO_VIPS
ARQUIVO_SALAS=
# Opcional — canais com publicação automática ligada (c+autoanuncio). Vazio = AutoAnuncio.json na mesma pasta de ARQUIVO_VIPS
ARQUIVO_AUTOANUNCIO=


# ============================================================
# PASTAS
# Caminhos absolutos para as pastas principais do bot
# ============================================================

# Pasta onde os backups são salvos — contém cópias do .env e todos os arquivos. Proteja com cuidado
PASTA_BACKUP=
# Pasta onde ficam todos os .json de memória do bot
PASTA_MEMORIAS=
# Pasta raiz do código-fonte do bot (onde fica bot.py, .env, Modulos/)
PASTA_SRC=


# ============================================================
# LOGS
# ID dos canais de texto onde o bot envia logs automáticos
# Cada categoria tem seu próprio canal para facilitar a leitura
# ============================================================

# Bot online/offline, erros gerais, Git e backup automático
LOGS_GERAIS=
# Todos os eventos de código: enviado, publicado, expirado, lembrete
LOGS_CODIGOS=
# Ações do painel e dos comandos de gerência: quem abriu, tentativas bloqueadas, autoanúncio, call
LOGS_PAINEL=
# Canal público de boas-vindas e saídas (mensagem com ping e avatar do membro)
LOGS_JOIN=
# Warns aplicados, removidos e expirados
LOGS_WARNS=
# VIP adicionado, removido, expirado automaticamente e ativado pelo banco
LOGS_VIP=
# Cargo de Amigo adicionado ou removido (qualquer origem)
LOGS_AMIGOS=
# Warns, timeouts, kicks e bans — pelo bot (inclui o softban do honeypot) e feitos manualmente por admins
LOGS_PUNICOES=
# Flood detectado, links bloqueados, divulgação, comandos em local errado
LOGS_MODERACAO=
# Entrada e saída, contas novas, cargos adicionados/removidos, apelido alterado
LOGS_MEMBROS=
# Mensagens apagadas (com conteúdo quando possível) e editadas (antes e depois)
LOGS_MENSAGENS=
# Entrada, saída, movimentação, expulsão, mute e surdo por admin
LOGS_CALLS=
# Alterações no servidor: nome, foto, verificação, notificações, AFK
LOGS_SERVIDOR=
# Canais criados, deletados, renomeados e permissões alteradas
LOGS_CANAIS=
# Cargos criados, deletados, renomeados e permissões alteradas
LOGS_CARGOS=
